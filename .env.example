# -----------------------------------------------------------------------------
# DIGITAL IMPERSONATION RESPONSE DESK - ENVIRONMENT CONFIGURATION TEMPLATE
# -----------------------------------------------------------------------------
# Copy this file to .env before running the application.
# NEVER commit production secrets or real API keys to source control.

# Server Configuration
NODE_ENV=development
PORT=4000
HOST=127.0.0.1
APP_URL=http://localhost:4000
WEB_URL=http://localhost:5173

# Security & Session Authentication
# In production/pilot mode, must be explicitly set, random, and at least 32 characters.
SESSION_SECRET=dev_session_secret_change_in_production_min_32_bytes_random
TOKEN_SIGNING_KEY=dev_hmac_token_key_change_in_production_min_32_bytes_random
DOWNLOAD_TOKEN_SECRET=dev_download_token_secret_32_bytes_min
SESSION_EXPIRY_HOURS=12

# Database Persistence
# Default: Local SQLite database with Write-Ahead-Logging (WAL)
DATABASE_PATH=./data/response_desk.sqlite
DATABASE_WAL_MODE=true

# Storage & Backups
EVIDENCE_STORAGE_DIR=./storage/evidence
EVIDENCE_TEMP_DIR=./storage/temp
BACKUP_STORAGE_DIR=./storage/backups
MAX_UPLOAD_SIZE_MB=50
SIGNED_URL_EXPIRY_SECONDS=300

# Retention Policies
DEFAULT_EVIDENCE_RETENTION_DAYS=180
AUDIT_RETENTION_DAYS=365

# Worker Scheduling (Milliseconds)
WORKER_RETENTION_INTERVAL_MS=60000
WORKER_CLOCK_INTERVAL_MS=60000
WORKER_NOTIFICATION_INTERVAL_MS=10000
WORKER_USAGE_INTERVAL_MS=60000
WORKER_BACKUP_VERIFY_INTERVAL_MS=3600000

# Operational Safety & External Mode Guards
# STRICT INVARIANT: Live actions, payments, and external notifications are DISABLED during controlled pilot.
PILOT_MODE=true
ENABLE_LIVE_PLATFORM_ACTIONS=false
ENABLE_LIVE_BILLING=false
ENABLE_LIVE_NOTIFICATIONS=false
NOTIFICATION_MODE=in_app
BILLING_MODE=dry_run

# Monitoring & Detection Provider Adapters
SYNTHETIC_MEDIA_DETECTOR_PROVIDER=mock
URL_MONITOR_PROVIDER=mock

# Statutory Clocks & Timezone
DEFAULT_TIMEZONE=Asia/Kolkata
STATUTORY_INTERMEDIARY_HOURS_HIGH_PRIORITY=24
STATUTORY_INTERMEDIARY_HOURS_GENERAL=72

# Audit Logging
AUDIT_LOG_ENABLED=true
