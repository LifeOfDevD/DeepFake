# -----------------------------------------------------------------------------
# DIGITAL IMPERSONATION RESPONSE DESK - PRODUCTION CONFIGURATION TEMPLATE
# -----------------------------------------------------------------------------
# STRICT INVARIANT: Never commit real production secrets to source control.
# All production secrets must be securely supplied via environment variables
# or a managed secret provider (AWS Secrets Manager, HashiCorp Vault, GCP Secret Manager).

# Server & Network
NODE_ENV=production
PORT=4000
HOST=0.0.0.0
APP_URL=https://desk.example.com
CORS_ALLOWED_ORIGINS=https://desk.example.com

# Core Authentication & Session Security (FAIL-CLOSED: MUST BE >= 32 RANDOM BYTES)
# Generate via: openssl rand -hex 32
SESSION_SECRET=REPLACE_WITH_CRYPTOGRAPHICALLY_RANDOM_SESSION_SECRET_MIN_32_CHARS
DOWNLOAD_TOKEN_SECRET=REPLACE_WITH_CRYPTOGRAPHICALLY_RANDOM_DOWNLOAD_SECRET_MIN_32_CHARS
TOKEN_SIGNING_KEY=REPLACE_WITH_CRYPTOGRAPHICALLY_RANDOM_HMAC_SIGNING_KEY_MIN_32_CHARS
SESSION_EXPIRY_HOURS=8

# Integration Token Encryption (AES-256-GCM Master Key, Min 32 chars)
ENCRYPTION_MASTER_KEY=REPLACE_WITH_AES_256_MASTER_KEY_MIN_32_CHARS_LONG_KEY
ENCRYPTION_FALLBACK_KEYS=

# Database Persistence (Production SQLite with WAL Mode or Managed Database)
DATABASE_PATH=/var/lib/response_desk/data/response_desk_prod.sqlite
DATABASE_WAL_MODE=true

# Storage Backend (Local isolated directory or S3/GCS Managed Bucket)
STORAGE_BACKEND=local
EVIDENCE_STORAGE_DIR=/var/lib/response_desk/storage/evidence
EVIDENCE_TEMP_DIR=/var/lib/response_desk/storage/temp
BACKUP_STORAGE_DIR=/var/lib/response_desk/storage/backups
MAX_UPLOAD_SIZE_MB=50
SIGNED_URL_EXPIRY_SECONDS=300

# Managed Object Storage (when STORAGE_BACKEND=managed_s3)
# S3_BUCKET_NAME=response-desk-evidence-prod
# S3_REGION=ap-south-1
# S3_KMS_KEY_ID=arn:aws:kms:ap-south-1:123456789012:key/abc-123

# Retention Lifecycle Policies
DEFAULT_EVIDENCE_RETENTION_DAYS=180
AUDIT_RETENTION_DAYS=365

# Worker Scheduling (Milliseconds)
WORKER_RETENTION_INTERVAL_MS=60000
WORKER_CLOCK_INTERVAL_MS=60000
WORKER_NOTIFICATION_INTERVAL_MS=10000
WORKER_USAGE_INTERVAL_MS=60000
WORKER_BACKUP_VERIFY_INTERVAL_MS=3600000
WORKER_MONITORING_INGESTION_INTERVAL_MS=60000
WORKER_CANDIDATE_EVALUATION_INTERVAL_MS=30000

# Operational Safety Guards (STRICT INVARIANT: No automated platform takedowns)
PILOT_MODE=true
ENABLE_LIVE_PLATFORM_ACTIONS=false
ENABLE_LIVE_BILLING=false
ENABLE_LIVE_NOTIFICATIONS=false
NOTIFICATION_MODE=in_app
BILLING_MODE=dry_run
RATE_LIMIT_ENABLED=true

# YouTube Integration (Read-Only)
# GOOGLE_CLIENT_ID=prod_client_id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=prod_client_secret_xyz
# GOOGLE_REDIRECT_URI=https://desk.example.com/api/integrations/oauth/callback
# WEBSUB_CALLBACK_URL=https://desk.example.com/api/integrations/youtube/webhook

# Statutory Clocks & Jurisdictions
DEFAULT_TIMEZONE=Asia/Kolkata
STATUTORY_INTERMEDIARY_HOURS_HIGH_PRIORITY=24
STATUTORY_INTERMEDIARY_HOURS_GENERAL=72
