# -----------------------------------------------------------------------------
# DIGITAL IMPERSONATION RESPONSE DESK - STAGING CONFIGURATION TEMPLATE
# -----------------------------------------------------------------------------
NODE_ENV=staging
PORT=4000
HOST=0.0.0.0
APP_URL=https://staging-desk.example.com
CORS_ALLOWED_ORIGINS=https://staging-desk.example.com

# Core Authentication & Session Security (Must be random, non-dev, >= 32 chars)
SESSION_SECRET=REPLACE_WITH_STAGING_SESSION_SECRET_MIN_32_CHARS_LONG
DOWNLOAD_TOKEN_SECRET=REPLACE_WITH_STAGING_DOWNLOAD_SECRET_MIN_32_CHARS_LONG
TOKEN_SIGNING_KEY=REPLACE_WITH_STAGING_HMAC_KEY_MIN_32_CHARS_LONG
SESSION_EXPIRY_HOURS=8

# Integration Token Encryption
ENCRYPTION_MASTER_KEY=REPLACE_WITH_STAGING_AES_KEY_MIN_32_CHARS_LONG
ENCRYPTION_FALLBACK_KEYS=

# Persistence
DATABASE_PATH=./data/response_desk_staging.sqlite
DATABASE_WAL_MODE=true

# Storage
STORAGE_BACKEND=local
EVIDENCE_STORAGE_DIR=./storage/staging_evidence
EVIDENCE_TEMP_DIR=./storage/staging_temp
BACKUP_STORAGE_DIR=./storage/staging_backups
MAX_UPLOAD_SIZE_MB=50

# Operational Safety Guards
PILOT_MODE=true
ENABLE_LIVE_PLATFORM_ACTIONS=false
ENABLE_LIVE_BILLING=false
ENABLE_LIVE_NOTIFICATIONS=false
NOTIFICATION_MODE=in_app
BILLING_MODE=dry_run
RATE_LIMIT_ENABLED=true
